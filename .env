# Existing folder the agent works in (mounted at /workspace)
WORKSPACE=C:/Users/zeesh/my-project
# Linux: files the agent creates will belong to you (run `id -u` and `id -g`)
HOST_UID=1000
HOST_GID=1000
# Any litellm model + the matching key (anthropic/, openai/, gemini/, ollama/ ...)
LLM_MODEL=ollama_chat/qwen2.5:7b
OLLAMA_API_BASE=http://host.docker.internal:11434
